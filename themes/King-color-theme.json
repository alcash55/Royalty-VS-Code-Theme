{
  "$schema": "vscode://schemas/color-theme",
  "name": "King",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#F2CE7E",
    "class": "#F2CE7E",
    "interface": "#F2CE7E",
    "type": "#F2CE7E",
    "enum": "#F2CE7E",
    "typeParameter": "#F2CE7E",
    "struct": "#F2CE7E",
    "function": "#7FD3EC",
    "method": "#7FD3EC",
    "macro": "#7FD3EC",
    "event": "#7FD3EC",
    "variable": "#DCD4EA",
    "parameter": "#F2B085",
    "property": "#DCD4EA",
    "enumMember": "#F5A0C4",
    "keyword": "#C89BF5",
    "modifier": "#C89BF5",
    "operator": "#B0A5C7",
    "string": "#9FD6A0",
    "number": "#F5A0C4",
    "regexp": "#F2B085",
    "comment": {
      "foreground": "#9A8FB6",
      "fontStyle": "italic"
    },
    "decorator": {
      "foreground": "#F2CE7E",
      "fontStyle": "italic"
    },
    "variable.constant": "#F5A0C4",
    "variable.defaultLibrary": "#F2CE7E",
    "variable.readonly": "#DCD4EA",
    "property.declaration": "#DCD4EA",
    "function.defaultLibrary": "#7FD3EC",
    "class.defaultLibrary": "#F2CE7E",
    "variable.deprecated": {
      "fontStyle": "strikethrough"
    },
    "function.deprecated": {
      "fontStyle": "strikethrough"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9A8FB6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "meta.attribute-selector"
      ],
      "settings": {
        "foreground": "#9FD6A0"
      }
    },
    {
      "name": "String punctuation",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9FD6A0"
      }
    },
    {
      "name": "Template expression punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Number, constant, language literal",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "constant.character.escape",
        "keyword.other.unit",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F5A0C4"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Storage and modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#B0A5C7"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B0A5C7"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "Function declaration name",
      "scope": [
        "entity.name.function.member",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "Class, type, interface, enum",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#F2CE7E"
      }
    },
    {
      "name": "Decorator and annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F2CE7E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DCD4EA"
      }
    },
    {
      "name": "Object property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#DCD4EA"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#F2B085"
      }
    },
    {
      "name": "Language variable (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#F5A0C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML/XML tag",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F5A0C4"
      }
    },
    {
      "name": "HTML/XML attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#F2CE7E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#F2CE7E"
      }
    },
    {
      "name": "CSS property name",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "meta.property-value"
      ],
      "settings": {
        "foreground": "#F5A0C4"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#F2B085"
      }
    },
    {
      "name": "Regular expression operator",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Module and import",
      "scope": [
        "support.module",
        "entity.name.type.module",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F2C94C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F2CE7E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C89BF5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9A8FB6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#F5A0C4"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9FD6A0"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#7FD3EC",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8FDCA0"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF8A8A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F2CE7E"
      }
    },
    {
      "name": "Diff header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#C89BF5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF8A8A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F2D06B",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "YAML/TOML key",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "Shell built-in and command",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell"
      ],
      "settings": {
        "foreground": "#7FD3EC"
      }
    },
    {
      "name": "Escape and placeholder",
      "scope": [
        "constant.character.format.placeholder",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#F2B085"
      }
    }
  ],
